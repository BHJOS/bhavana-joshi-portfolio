---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/about/me.webp';
---

<BaseLayout
  title="About"
  description="Bhavana Joshi is a senior product designer who takes products from concept to code, with twenty years across health, pharmaceutical, and financial platforms."
>
  <section class="container-content pt-20 pb-24 md:pt-32">
    <div class="grid grid-cols-1 gap-x-16 gap-y-12 md:grid-cols-5">
      <div class="md:col-span-3">
        <h1 class="text-h1 md:text-display text-balance">
          I design and develop products from concept to code.
        </h1>

        <div class="mt-10 max-w-2xl space-y-6 text-lead text-ink-muted">
          <p>
            As a senior product designer with twenty years of experience across health,
            pharmaceutical, and financial platforms, I understand the importance of
            accessibility, compliance, and clarity under pressure. I regularly prototype in production-grade React and TypeScript
            using Claude Code, enabling teams to test real product behavior early rather than
            discussing static screens. I have also created and integrated AI-powered features
            into shipped products.
          </p>
          <p>
            My expertise includes research, interaction design, design systems, and data
            visualization, with WCAG 2.2 accessibility built in from the start rather than
            added later. I am passionate about projects that bring people together and
            celebrate our diversity.
          </p>
        </div>
      </div>

      <div class="md:col-span-2">
        {/*
          TODO(alt): alt text for this portrait was not in the rescue manifest.
          Rendering alt="" until Bhavana writes it — a wrong description is worse
          than none. Reported by `npm run audit:alt`.
        */}
        <Image
          src={portrait}
          alt=""
          width={600}
          densities={[1, 2]}
          loading="eager"
          decoding="async"
          sizes="(min-width: 768px) 400px, 100vw"
          class="w-full border border-rule"
        />
      </div>
    </div>
  </section>

</BaseLayout>
