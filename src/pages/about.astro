---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TAGLINE } from '../consts';
import portrait from '../assets/about/me.webp';
---

<BaseLayout
  title="About"
  description="Bhavana Joshi is a product designer working across digital design, advertising, and marketing communication. Creativity with purpose."
>
  <section class="container-content pt-20 pb-24 md:pt-32">
    <div class="grid grid-cols-1 gap-x-16 gap-y-12 md:grid-cols-5">
      <div class="md:col-span-3">
        <h1 class="text-h1 md:text-display text-balance">{SITE_TAGLINE}</h1>

        <div class="mt-10 max-w-2xl space-y-6 text-lead text-ink-muted">
          <p>
            Innovation is not always about creating new but adding value, identifying
            challenges and problems, and offering creative solutions.
          </p>
          <p>
            As a product designer, I bring a wealth of cross-functional experience in digital
            design, advertising, and marketing communication. I believe in finding solutions
            that are inclusive, provide real value, and enhance user experience.
          </p>
          <p>
            My expertise includes research, interaction design, design systems, and data
            visualization, with WCAG 2.2 accessibility built in from the start rather than
            added later. I am passionate about projects that bring people together and
            celebrate our diversity.
          </p>
        </div>
      </div>

      <div class="md:col-span-2">
        <Image
          src={portrait}
          alt="Self portrait of Bhavana Joshi"
          width={600}
          densities={[1, 2]}
          loading="eager"
          decoding="async"
          sizes="(min-width: 768px) 400px, 100vw"
          class="w-full border border-rule"
        />
      </div>
    </div>
  </section>

</BaseLayout>
