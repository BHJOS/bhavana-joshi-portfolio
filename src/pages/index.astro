---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import LogoTicker from '../components/LogoTicker.astro';
import { SITE_TAGLINE, EMAIL, LINKEDIN, CLIENTS } from '../consts';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Client logos are plain PNGs from the old site, so they are globbed rather than
// imported one by one.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/logos/*.png',
  { eager: true }
);
const logos = CLIENTS.flatMap((c) => {
  const img = logoFiles[`../assets/logos/${c.file}`]?.default;
  return img ? [{ name: c.name, img, h: c.h }] : [];
});

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bhavana Joshi',
  jobTitle: 'Product Designer',
  email: `mailto:${EMAIL}`,
  url: Astro.site?.href,
  sameAs: [LINKEDIN],
  description:
    'Product designer with cross-functional experience in digital design, advertising, and marketing communication.',
};
---

<BaseLayout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </Fragment>

  {/* Hero */}
  <section class="container-content pt-20 pb-24 md:pt-32 md:pb-32">
    <h1 class="text-display md:text-display-lg text-balance">{SITE_TAGLINE}</h1>
    <div class="mt-10 max-w-2xl space-y-6 text-lead text-ink-muted">
      <p>
        Innovation is not always about creating new but adding value, identifying
        challenges and problems, and offering creative solutions.
      </p>
      <p>
        As a product designer, I bring a wealth of cross-functional experience in digital
        design, advertising, and marketing communication. I believe in finding solutions
        that are inclusive, provide real value, and enhance user experience.
      </p>
    </div>
  </section>

  {/* Featured work — the accent black block, cards in dark tone */}
  <section class="bg-black py-24 md:py-32" aria-labelledby="work-heading">
    <div class="container-content">
      <div class="flex items-baseline justify-between">
        <h2 id="work-heading" class="text-h1 text-paper">Selected work</h2>
        <a
          href="/work"
          class="text-meta uppercase text-paper underline underline-offset-8 hover:opacity-60"
        >
          All work
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-16 md:grid-cols-2">
        {
          work.map((entry, i) => (
            <WorkCard entry={entry} tone="dark" loading={i < 2 ? 'eager' : 'lazy'} />
          ))
        }
      </div>
    </div>
  </section>

  {/* Client logo ticker — directly above the footer */}
  <LogoTicker logos={logos} />
</BaseLayout>
