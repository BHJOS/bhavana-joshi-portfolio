---
import { EMAIL, LINKEDIN } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-rule">
  <div class="container-content flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-h3 font-semibold tracking-tight">Bhavana Joshi</p>
      <p class="mt-2 text-body text-ink-muted">
        <a href={`mailto:${EMAIL}`} class="text-ink underline underline-offset-4 hover:opacity-60">
          {EMAIL}
        </a>
        <span class="mx-2 text-rule" aria-hidden="true">|</span>
        <a
          href={LINKEDIN}
          rel="me noopener"
          class="text-ink underline underline-offset-4 hover:opacity-60"
        >
          LinkedIn
        </a>
      </p>
    </div>

    <p class="text-meta uppercase text-ink-muted">
      © {year} Bhavana Joshi. All rights reserved.
    </p>
  </div>
</footer>
