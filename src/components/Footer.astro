---
import { EMAIL, LINKEDIN } from '../consts';

const year = new Date().getFullYear();
---

{/*
  The footer IS the contact CTA — pages do not repeat "start a conversation"
  sections above it. See CLAUDE.md → Aesthetic for the sanctioned tint.
*/}
<footer class="mt-32 bg-footer">
  <div class="container-content py-16 md:py-24">
    <h2 class="text-h1 text-balance">Let's start a conversation.</h2>
    <p class="mt-8 flex flex-wrap items-baseline gap-x-8 gap-y-3 text-lead">
      <a href={`mailto:${EMAIL}`} class="underline underline-offset-8 hover:opacity-60">
        {EMAIL}
      </a>
      <a
        href={LINKEDIN}
        rel="me noopener"
        class="underline underline-offset-8 hover:opacity-60"
      >
        LinkedIn
      </a>
    </p>

    <p class="mt-16 text-meta uppercase text-ink-muted">
      © {year} Bhavana Joshi. USA. All rights reserved.
    </p>
  </div>
</footer>
