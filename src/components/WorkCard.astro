---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Eager-load above-the-fold cards so the LCP image is not lazy. */
  loading?: 'lazy' | 'eager';
  /** Heading level, so the card fits the host page's outline without skips. */
  headingLevel?: 'h2' | 'h3';
  /** 'dark' when the card sits on a black section (homepage). Text flips to paper.
      paper/60 on black is ~5.9:1, an AA pass for the 13px meta lines. */
  tone?: 'light' | 'dark';
  /** 16px corner radius on the thumbnail frame. Only the Work index uses it (Bhavana, 2026-09-15). */
  rounded?: boolean;
}

const {
  entry,
  loading = 'lazy',
  headingLevel: Heading = 'h3',
  tone = 'light',
  rounded = false,
} = Astro.props;
const { title, client, year, tags, hero, heroAlt, heroAltTodo, gated } = entry.data;

// A flagged image renders silent rather than announcing a placeholder string.
// The card title directly follows, so the link is never unlabeled.
const alt = heroAltTodo ? '' : heroAlt;

const dark = tone === 'dark';
const metaClass = dark ? 'text-paper/60' : 'text-ink-muted';
const strongClass = dark ? 'text-paper' : 'text-ink';
---

<article class="group">
  <a href={`/work/${entry.id}`} class="block no-underline">
    <div
      class:list={[
        'overflow-hidden border transition-opacity group-hover:opacity-85',
        rounded && 'rounded-2xl',
        dark ? 'border-paper/20' : 'border-rule',
      ]}
      style="aspect-ratio: 3 / 2"
    >
      <Image
        src={hero}
        alt={alt}
        width={800}
        densities={[1, 2]}
        loading={loading}
        decoding="async"
        sizes="(min-width: 768px) 520px, 100vw"
        class="h-full w-full object-cover"
      />
    </div>

    <div class="mt-5">
      <p class:list={['text-meta uppercase', metaClass]}>
        {client} · {year}
        {gated && <span class:list={['ml-2', strongClass]}>· Password protected</span>}
      </p>
      <Heading
        class:list={[
          'mt-2 text-h2 underline-offset-8 group-hover:underline decoration-1',
          strongClass,
        ]}
      >
        {title}
      </Heading>
      <p class:list={['mt-3 text-meta uppercase', metaClass]}>{tags.join(' · ')}</p>
    </div>
  </a>
</article>
