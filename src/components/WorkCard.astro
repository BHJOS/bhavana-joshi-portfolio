---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Eager-load above-the-fold cards so the LCP image is not lazy. */
  loading?: 'lazy' | 'eager';
  /** Heading level, so the card fits the host page's outline without skips. */
  headingLevel?: 'h2' | 'h3';
}

const { entry, loading = 'lazy', headingLevel: Heading = 'h3' } = Astro.props;
const { title, client, year, tags, hero, heroAlt, heroAltTodo, gated } = entry.data;

// A flagged image renders silent rather than announcing a placeholder string.
// The card title directly follows, so the link is never unlabeled.
const alt = heroAltTodo ? '' : heroAlt;
---

<article class="group">
  <a href={`/work/${entry.id}`} class="block no-underline">
    <Image
      src={hero}
      alt={alt}
      width={800}
      densities={[1, 2]}
      loading={loading}
      decoding="async"
      sizes="(min-width: 768px) 520px, 100vw"
      class="w-full border border-rule transition-opacity group-hover:opacity-85"
    />

    <div class="mt-5">
      <p class="text-meta uppercase text-ink-muted">
        {client} · {year}
        {gated && <span class="ml-2 text-ink">· Password protected</span>}
      </p>
      <Heading
        class="mt-2 text-h2 text-ink underline-offset-8 group-hover:underline decoration-1"
      >
        {title}
      </Heading>
      <p class="mt-3 text-meta uppercase text-ink-muted">{tags.join(' · ')}</p>
    </div>
  </a>
</article>
