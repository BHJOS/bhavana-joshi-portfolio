---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Labelled before/after comparison. Static side-by-side, not a drag slider —
 * a slider would need client JS and would be unusable by keyboard.
 * The labels are real text, so the comparison survives with images off.
 */
interface Side {
  src: ImageMetadata;
  alt?: string;
  altTodo?: boolean;
}

interface Props {
  before: Side;
  after: Side;
  beforeLabel?: string;
  afterLabel?: string;
}

const { before, after, beforeLabel = 'Before', afterLabel = 'After' } = Astro.props;

for (const [name, side] of [
  ['before', before],
  ['after', after],
] as const) {
  if (!side.altTodo && side.alt === undefined) {
    throw new Error(`BeforeAfter: \`${name}\` needs \`alt\` or \`altTodo\`. Never invent alt text.`);
  }
}

const sides = [
  { ...before, label: beforeLabel },
  { ...after, label: afterLabel },
];
---

<div class="my-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    sides.map((s) => (
      <figure>
        <figcaption class="mb-3 inline-block bg-ink px-3 py-1 text-meta uppercase text-paper">
          {s.label}
        </figcaption>
        {s.altTodo && <Fragment set:html="<!-- TODO(alt): needs alt text from Bhavana -->" />}
        <Image
          src={s.src}
          alt={s.altTodo ? '' : s.alt!}
          width={900}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
          sizes="(min-width: 640px) 540px, 100vw"
          class="w-full border border-rule"
        />
      </figure>
    ))
  }
</div>
