---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Responsive image grid. Use for sets of 3+ related images. */
interface Item {
  src: ImageMetadata;
  alt?: string;
  altTodo?: boolean;
  caption?: string;
}

interface Props {
  items: Item[];
  /** Columns at the widest breakpoint. Grid steps down on smaller screens. */
  columns?: 2 | 3 | 4;
  /** One caption for the set as a whole. Composable with per-item captions. */
  caption?: string;
  /**
   * 'contain' (default) shows every image whole, centered in the shared frame. Right
   * for UI screenshots, where cropping loses content. 'cover' fills the frame edge to
   * edge and crops the overflow. For photographs only (Bhavana, 2026-09-18).
   */
  fit?: 'contain' | 'cover';
}

const { items, columns = 3, caption, fit = 'contain' } = Astro.props;
const fitClass = fit === 'cover' ? 'object-cover' : 'object-contain';

// One frame size for the whole set: the tallest image's ratio. Wider images sit
// centered inside it with their full content intact rather than being cropped.
const ratio = Math.min(...items.map((it) => it.src.width / it.src.height));

for (const [i, it] of items.entries()) {
  if (!it.altTodo && it.alt === undefined) {
    throw new Error(`Gallery: item ${i} needs \`alt\` or \`altTodo\`. Never invent alt text.`);
  }
}

const colClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];

const widthHint = { 2: 900, 3: 600, 4: 460 }[columns];
const sizesHint = {
  2: '(min-width: 640px) 540px, 100vw',
  3: '(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw',
  4: '(min-width: 1024px) 270px, (min-width: 640px) 50vw, 100vw',
}[columns];
---

<figure class="my-12">
<ul class={`grid list-none grid-cols-1 gap-6 p-0 ${colClass}`}>
  {
    items.map((it) => (
      <li>
        <figure>
          {it.altTodo && <Fragment set:html="<!-- TODO(alt): needs alt text from Bhavana -->" />}
          <div class="overflow-hidden border border-rule" style={`aspect-ratio: ${ratio}`}>
            <Image
              src={it.src}
              alt={it.altTodo ? '' : it.alt!}
              width={widthHint}
              densities={[1, 2]}
              loading="lazy"
              decoding="async"
              sizes={sizesHint}
              class={`h-full w-full ${fitClass}`}
            />
          </div>
          {it.caption && (
            <figcaption class="mt-3 text-meta text-ink-muted normal-case tracking-normal">
              {it.caption}
            </figcaption>
          )}
        </figure>
      </li>
    ))
  }
</ul>
{
  caption && (
    <figcaption class="mt-4 max-w-2xl text-meta text-ink-muted normal-case tracking-normal">
      {caption}
    </figcaption>
  )
}
</figure>
