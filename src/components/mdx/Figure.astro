---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Shared image primitive for every MDX component.
 *
 * Alt-text contract (see CLAUDE.md → Accessibility):
 *   alt="..."      normal — a real description
 *   alt=""         decorative, deliberately silent to screen readers
 *   altTodo        alt text has NOT been written yet. Renders alt="" so the image is
 *                  not announced with a misleading description, emits an HTML comment
 *                  marker, and is picked up by `npm run audit:alt`.
 */
interface Props {
  src: ImageMetadata;
  alt?: string;
  /** Set when Bhavana still needs to write the alt text for this image. */
  altTodo?: boolean;
  caption?: string;
  /** Rendered width hint. Astro never upscales past the source. */
  width?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  sizes?: string;
}

const {
  src,
  alt,
  altTodo = false,
  caption,
  width = 1400,
  loading = 'lazy',
  class: className = '',
  sizes = '(min-width: 1100px) 1100px, 100vw',
} = Astro.props;

if (!altTodo && alt === undefined) {
  throw new Error(
    'Figure: `alt` is required. Pass alt="" for a decorative image, or altTodo for one ' +
      'whose alt text has not been written yet. Never invent alt text.'
  );
}

const resolvedAlt = altTodo ? '' : alt!;
---

<figure class={`my-12 ${className}`}>
  {altTodo && <Fragment set:html="<!-- TODO(alt): needs alt text from Bhavana -->" />}
  <Image
    src={src}
    alt={resolvedAlt}
    width={width}
    densities={[1, 2]}
    loading={loading}
    decoding="async"
    sizes={sizes}
    class="w-full border border-rule"
  />
  {
    caption && (
      <figcaption class="mt-3 text-meta text-ink-muted normal-case tracking-normal">
        {caption}
      </figcaption>
    )
  }
</figure>
